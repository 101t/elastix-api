{
    "name": "101t/asterisk-pbx-api",
    "description": "Modern PHP API package for Asterisk, Issabel PBX and FreePBX — supports AMI, ARI, PJSIP and legacy SIP channels",
    "type": "library",
    "keywords": ["asterisk", "issabel", "freepbx", "pbx", "voip", "sip", "pjsip", "ami", "ari", "telephony"],
    "homepage": "https://github.com/101t/elastix-api",
    "license": "MIT",
    "authors": [
        {
            "name": "101t",
            "homepage": "https://github.com/101t"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "PbxApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PbxApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit --testdox",
        "test-coverage": "vendor/bin/phpunit --coverage-text"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
